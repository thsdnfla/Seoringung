NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://YOUR_DEPLOYMENT_URL/api/naver-callback
NAVER_OAUTH_STATE=
NAVER_ADMIN_REFRESH_TOKEN=

# 네이버 캘린더 CalDAV 로그인 정보. 2단계 인증 사용 시 앱 비밀번호를 입력합니다.
NAVER_CALDAV_USERNAME=
NAVER_CALDAV_PASSWORD=

# 자동 검색이 되지 않을 때만 CalDAV 캘린더 URL을 입력합니다.
# NAVER_CALDAV_CALENDAR_URL=
